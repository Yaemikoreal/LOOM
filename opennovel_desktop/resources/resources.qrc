<!DOCTYPE RCC>
<RCC version="1.0">
    <qresource prefix="/">
        <!-- Icons -->
        <file alias="icons/write-chapter.svg">icons/write-chapter.svg</file>
        <file alias="icons/auto.svg">icons/auto.svg</file>
        <file alias="icons/stop.svg">icons/stop.svg</file>
        <file alias="icons/commit.svg">icons/commit.svg</file>
        <file alias="icons/stash.svg">icons/stash.svg</file>
        <file alias="icons/save.svg">icons/save.svg</file>
        <file alias="icons/search.svg">icons/search.svg</file>
        <file alias="icons/settings.svg">icons/settings.svg</file>
        <file alias="icons/file.svg">icons/file.svg</file>
        <file alias="icons/character.svg">icons/character.svg</file>
        <file alias="icons/outline.svg">icons/outline.svg</file>
        <!-- Themes -->
        <file alias="themes/base.qss">themes/base.qss</file>
        <file alias="themes/light.qss">themes/light.qss</file>
        <file alias="themes/dark.qss">themes/dark.qss</file>
    </qresource>
</RCC>
