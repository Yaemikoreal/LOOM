/* ══════════════════════════════════════════════════════════════
   OpenNovel Desktop — 暗色主题变量
   深石墨灰底色 + 暖朱红强调色
   ══════════════════════════════════════════════════════════════ */

/* ── 全局色值 ──────────────────────────────────────────── */
QWidget {
    background: #222224;
    color: #E4E4E7;
}

QMainWindow {
    background: #222224;
}

/* ── 三栏面板分层 ──────────────────────────────────────── */
/* 左侧导航 + 右侧面板：深一级背景 */
#LeftPanel, #RightPanel {
    background: #1E1E20;
}

/* 中央编辑器：略亮，模拟纸色 */
#EditorTabs {
    background: #2A2A2D;
}
#EditorTabs::pane {
    background: #2A2A2D;
    border-top: 1px solid #3A3A3D;
}
QPlainTextEdit {
    background: #2A2A2D;
}
NovelEditor {
    background: #2A2A2D;
}

/* ── QSplitter（分割线始终可见） ────────────────────────── */
QSplitter::handle {
    background: #3A3A3D;
    width: 4px;
    height: 4px;
}
QSplitter::handle:hover {
    background: #C96A58;
}
QSplitter::handle:pressed {
    background: #B85A48;
}

/* ── QToolBar ──────────────────────────────────────────── */
QToolBar {
    background: #28282A;
    border-bottom: 1px solid #3A3A3D;
}

/* ── QToolButton ────────────────────────────────────────── */
QToolButton:hover {
    background: #3A3A3D;
}
QToolButton:pressed {
    background: #4A4A4D;
}
QToolButton:disabled {
    opacity: 0.35;
}
/* 加载中状态的工具栏按钮 */
QToolButton[loading="true"] {
    background: #2A2A2D;
    border: 1px solid #C96A58;
}

/* ── QMenuBar ──────────────────────────────────────────── */
QMenuBar {
    background: #222224;
    color: #E4E4E7;
}
QMenuBar::item:selected {
    background: #3A3A3D;
}

/* ── QMenu ──────────────────────────────────────────────── */
QMenu {
    background: #2A2A2D;
    color: #E4E4E7;
    border-color: #4A4A4D;
}
QMenu::item:selected {
    background: #3A2828;
    color: #E4E4E7;
}
QMenu::separator {
    background: #3A3A3D;
}

/* ── QStatusBar ─────────────────────────────────────────── */
QStatusBar {
    background: #28282A;
    color: #9A9A9E;
    border-top-color: #3A3A3D;
}

/* ── QTabWidget / QTabBar ───────────────────────────────── */
QTabWidget::pane {
    background: #222224;
    border-top-color: #3A3A3D;
}
QTabBar {
    background: #28282A;
}
QTabBar::tab {
    color: #9A9A9E;
}
QTabBar::tab:selected {
    color: #E4E4E7;
    border-bottom-color: #C96A58;
}
QTabBar::tab:hover:!selected {
    color: #E4E4E7;
    background: #3A3A3D;
}

/* ── QListWidget / QTreeWidget ───────────────────────────── */
QListWidget, QTreeWidget {
    background: transparent;
    color: #E4E4E7;
}
QListWidget::item:selected, QTreeWidget::item:selected {
    background: #3A2828;
    color: #E4E4E7;
}
QListWidget::item:hover:!selected, QTreeWidget::item:hover:!selected {
    background: #323234;
}

/* ── QPushButton ─────────────────────────────────────────── */
/* 主按钮 */
QPushButton {
    background: #C96A58;
    color: #FFFFFF;
}
QPushButton:hover {
    background: #D97A68;
}
QPushButton:pressed {
    background: #B85A48;
}
QPushButton:disabled {
    background: #3A3A3D;
    color: #6E6E72;
}
/* 次级按钮 */
QPushButton#SecondaryButton {
    background: transparent;
    color: #E4E4E7;
    border: 1px solid #4A4A4D;
}
QPushButton#SecondaryButton:hover {
    background: #323234;
    border-color: #5E5E62;
}
/* 危险按钮 */
QPushButton#DangerButton {
    background: transparent;
    color: #C96A58;
    border: 1px solid #C96A58;
}
QPushButton#DangerButton:hover {
    background: #3A2828;
}

/* ── QLineEdit / QSpinBox ────────────────────────────────── */
QLineEdit, QSpinBox {
    background: #28282A;
    color: #E4E4E7;
    border-color: #4A4A4D;
}
QLineEdit:focus, QSpinBox:focus {
    border-color: #C96A58;
}
QLineEdit:disabled {
    background: #323234;
    color: #6E6E72;
}

/* ── QScrollBar ──────────────────────────────────────────── */
QScrollBar::handle:vertical {
    background: #4A4A4D;
}
QScrollBar::handle:vertical:hover {
    background: #5E5E62;
}
QScrollBar::handle:horizontal {
    background: #4A4A4D;
}
QScrollBar::handle:horizontal:hover {
    background: #5E5E62;
}

/* ── QToolTip ─────────────────────────────────────────────── */
QToolTip {
    background: #E4E4E7;
    color: #1E1E20;
}

/* ── QSlider ──────────────────────────────────────────────── */
QSlider::groove:horizontal {
    background: #3A3A3D;
}
QSlider::handle:horizontal {
    background: #C96A58;
    border: 2px solid #28282A;
}
QSlider::sub-page:horizontal {
    background: #C96A58;
}

/* ── QProgressBar ─────────────────────────────────────────── */
QProgressBar {
    background: #323234;
    color: #9A9A9E;
}
QProgressBar::chunk {
    background: #C96A58;
}

/* ── QDialog ──────────────────────────────────────────────── */
QDialog {
    background: #28282A;
}

/* ── QGroupBox ────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #3A3A3D;
    border-radius: 4px;
    margin-top: 16px;
    padding: 16px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

/* ── QCheckBox / QRadioButton ─────────────────────────────── */
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #5E5E62;
    border-radius: 3px;
}
QCheckBox::indicator:checked {
    background: #C96A58;
    border-color: #C96A58;
}
