/* ══════════════════════════════════════════════════════════════
   OpenNovel Desktop — 亮色主题变量
   暖白/米白纸色 + 暗朱红强调色
   ══════════════════════════════════════════════════════════════ */

/* ── 全局色值 ──────────────────────────────────────────── */
QWidget {
    background: #EDE9E4;
    color: #2D2A26;
}

QMainWindow {
    background: #EDE9E4;
}

/* ── 三栏面板分层 ──────────────────────────────────────── */
/* 左侧导航 + 右侧面板：略深一级背景，与编辑器区分 */
#LeftPanel, #RightPanel {
    background: #E8E4DE;
}

/* 中央编辑器：暖白纸色 */
#EditorTabs {
    background: #F5F0E8;
}
#EditorTabs::pane {
    background: #F5F0E8;
    border-top: 1px solid #D8D4CE;
}
/* QPlainTextEdit 编辑器本身 */
QPlainTextEdit {
    background: #F5F0E8;
}
NovelEditor {
    background: #F5F0E8;
}

/* ── QSplitter（分割线始终可见） ────────────────────────── */
QSplitter::handle {
    background: #D8D4CE;
    width: 4px;
    height: 4px;
}
QSplitter::handle:hover {
    background: #B85C4A;
}
QSplitter::handle:pressed {
    background: #A04D3C;
}

/* ── QToolBar ──────────────────────────────────────────── */
QToolBar {
    background: #E0DCD5;
    border-bottom: 1px solid #D0CCC4;
}

/* ── QToolButton ────────────────────────────────────────── */
QToolButton:hover {
    background: #D8D4CE;
}
QToolButton:pressed {
    background: #C8C4BE;
}
QToolButton:disabled {
    opacity: 0.35;
}
/* 加载中状态的工具栏按钮 */
QToolButton[loading="true"] {
    background: #F5F0E8;
    border: 1px solid #B85C4A;
}

/* ── QMenuBar ──────────────────────────────────────────── */
QMenuBar {
    background: #EDE9E4;
    color: #2D2A26;
}
QMenuBar::item:selected {
    background: #D8D4CE;
}

/* ── QMenu ──────────────────────────────────────────────── */
QMenu {
    background: #F5F0E8;
    color: #2D2A26;
    border-color: #C8C4BE;
}
QMenu::item:selected {
    background: #F3E4E0;
    color: #2D2A26;
}
QMenu::separator {
    background: #D8D4CE;
}

/* ── QStatusBar ─────────────────────────────────────────── */
QStatusBar {
    background: #E0DCD5;
    color: #6B6863;
    border-top-color: #D0CCC4;
}
QStatusBar QLabel {
    padding: 0 8px;
    border: none;
}

/* ── QTabWidget / QTabBar ───────────────────────────────── */
QTabWidget::pane {
    background: #EDE9E4;
    border-top-color: #D8D4CE;
}
QTabBar {
    background: #E0DCD5;
}
QTabBar::tab {
    color: #6B6863;
}
QTabBar::tab:selected {
    color: #2D2A26;
    border-bottom-color: #B85C4A;
}
QTabBar::tab:hover:!selected {
    color: #2D2A26;
    background: #D8D4CE;
}

/* ── QListWidget / QTreeWidget ───────────────────────────── */
QListWidget, QTreeWidget {
    background: transparent;
    color: #2D2A26;
}
QListWidget::item:selected, QTreeWidget::item:selected {
    background: #F3E4E0;
    color: #2D2A26;
}
QListWidget::item:hover:!selected, QTreeWidget::item:hover:!selected {
    background: #F5F0E8;
}

/* ── QPushButton ─────────────────────────────────────────── */
/* 主按钮（强调色） */
QPushButton {
    background: #B85C4A;
    color: #FFFFFF;
}
QPushButton:hover {
    background: #A04D3C;
}
QPushButton:pressed {
    background: #8B3F30;
}
QPushButton:disabled {
    background: #D8D4CE;
    color: #A8A49E;
}
/* 次级按钮 */
QPushButton#SecondaryButton {
    background: transparent;
    color: #2D2A26;
    border: 1px solid #D8D4CE;
}
QPushButton#SecondaryButton:hover {
    background: #F5F0E8;
    border-color: #C8C4BE;
}
/* 危险按钮 */
QPushButton#DangerButton {
    background: transparent;
    color: #B85C4A;
    border: 1px solid #B85C4A;
}
QPushButton#DangerButton:hover {
    background: #FFF0EE;
}

/* ── QLineEdit / QSpinBox ────────────────────────────────── */
QLineEdit, QSpinBox {
    background: #FFFFFF;
    color: #2D2A26;
    border-color: #D8D4CE;
}
QLineEdit:focus, QSpinBox:focus {
    border-color: #B85C4A;
}
QLineEdit:disabled {
    background: #EDE9E4;
    color: #A8A49E;
}

/* ── QScrollBar ──────────────────────────────────────────── */
QScrollBar::handle:vertical {
    background: #C8C4BE;
}
QScrollBar::handle:vertical:hover {
    background: #B8B4AE;
}
QScrollBar::handle:horizontal {
    background: #C8C4BE;
}
QScrollBar::handle:horizontal:hover {
    background: #B8B4AE;
}

/* ── QToolTip ─────────────────────────────────────────────── */
QToolTip {
    background: #2D2A26;
    color: #FFFFFF;
}

/* ── QSlider ──────────────────────────────────────────────── */
QSlider::groove:horizontal {
    background: #D8D4CE;
}
QSlider::handle:horizontal {
    background: #B85C4A;
    border: 2px solid #FFFFFF;
}
QSlider::sub-page:horizontal {
    background: #B85C4A;
}

/* ── QProgressBar ─────────────────────────────────────────── */
QProgressBar {
    background: #EDE9E4;
    color: #6B6863;
}
QProgressBar::chunk {
    background: #B85C4A;
}

/* ── QDialog ──────────────────────────────────────────────── */
QDialog {
    background: #F5F0E8;
}

/* ── QGroupBox ────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #D8D4CE;
    border-radius: 4px;
    margin-top: 16px;
    padding: 16px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
}

/* ── QCheckBox / QRadioButton ─────────────────────────────── */
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #C8C4BE;
    border-radius: 3px;
}
QCheckBox::indicator:checked {
    background: #B85C4A;
    border-color: #B85C4A;
}
